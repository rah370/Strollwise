APP_NAME=StrollWise API
ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://strollwise:strollwise@db:5432/strollwise
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

H3_RESOLUTION=8
CITY_CENTER_LAT=10.3157
CITY_CENTER_LNG=123.8854

CACHE_TTL_ZONES_SECONDS=60
CACHE_TTL_PULSE_SECONDS=120
PENDING_CACHE_TTL_SECONDS=900
PENDING_MIN_REPORTS_PER_CELL=2
PENDING_AGREEMENT_RATIO=0.6

S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
UPLOAD_LOCAL_DIR=/tmp/strollwise-uploads

CORS_ORIGINS=*
