APP_NAME="StrollWise API"
ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://strollwise:strollwise@localhost:5432/strollwise
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

H3_RESOLUTION=8
CITY_CENTER_LAT=10.3157
CITY_CENTER_LNG=123.8854

# Optional — Mapbox Geocoding API + placement verification script
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/streets-v12

CACHE_TTL_ZONES_SECONDS=60
CACHE_TTL_ZONE_FEED_SECONDS=25
CACHE_TTL_PULSE_SECONDS=120
PENDING_CACHE_TTL_SECONDS=900
PENDING_MIN_REPORTS_PER_CELL=3
PENDING_AGREEMENT_RATIO=0.6
REPORT_COOLDOWN_HOURS_PER_CELL=24
REPORT_MAX_PER_USER_PER_HOUR=30

# Object storage (required in production). For Cloudflare R2, set S3_ENDPOINT_URL
# and S3_PUBLIC_BASE_URL (custom domain or r2.dev). Region can be "auto".
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
UPLOAD_LOCAL_DIR=/tmp/strollwise-uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Local CORS. Production must list exact HTTPS origins, e.g.
# CORS_ORIGINS=https://admin.strollwise.app,https://app.strollwise.app
# TRUSTED_HOSTS=api.strollwise.app,localhost
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REPORTS_PER_MINUTE=20
RATE_LIMIT_GEOCODE_PER_MINUTE=30

# Optional error tracking
SENTRY_DSN=

# Production example (do not use these values locally):
# ENV=production
# DEBUG=false
# JWT_SECRET_KEY=<long-random-secret>
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# REDIS_URL=rediss://default:<password>@<upstash-host>:6379
# CORS_ORIGINS=https://admin.strollwise.app,https://app.strollwise.app
# TRUSTED_HOSTS=api.strollwise.app,localhost
